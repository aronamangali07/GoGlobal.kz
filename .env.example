# Скопируйте этот файл в .env.local и заполните. .env.local в git не попадает.

# Адрес сайта (локально — http://localhost:3000, на Vercel — https://<ваш-проект>.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Секретный ключ: только на сервере, никогда не с префиксом NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Этап 7: Resend и Telegram
RESEND_API_KEY=
EMAIL_FROM="GoGlobal <onboarding@resend.dev>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# Необязательно: для npm run db:run (применить SQL-файл через Management API)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
TELEGRAM_BOT_INFO=
EMAIL_OVERRIDE_TO=
